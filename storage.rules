rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Files are uploaded by each player under their own uid. Names carry a
    // timestamp (before-123, after-123, video-123, photo-123; the host phone's portrait-123 and scoreboard headshot-123) so a re-take never serves
    // a stale cached copy.
    match /sessions/{code}/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && (
          (file.matches('(before|after|photo|portrait|headshot)-[0-9]+')
            && request.resource.contentType.matches('image/.*')
            && request.resource.size < 15 * 1024 * 1024)
          ||
          // Prize photos go up several at once: prize-<time>-<n>.
          (file.matches('prize-[0-9]+-[0-9]+')
            && request.resource.contentType.matches('image/.*')
            && request.resource.size < 15 * 1024 * 1024)
          ||
          // Videos: 400 MB at most, to keep the Storage bill down. Keep in step with MAX_VIDEO_MB in
          // src/videoLimits.ts (the phone also caps the length there, which Storage can't check).
          (file.matches('video-[0-9]+')
            && request.resource.contentType.matches('video/.*')
            && request.resource.size <= 400 * 1024 * 1024)
        );
    }
  }
}
