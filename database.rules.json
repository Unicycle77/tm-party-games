{
  "rules": {
    "sessions": {
      "$code": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)",
        "hostUid": {
          ".write": "auth != null && data.exists() && newData.val() === auth.uid",
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "controllerUid": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
          ".validate": "newData.isString()"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            }
          }
        },
        "games": {
          "beforeAfter": {
            "media": {
              "$uid": {
                ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || !(data.child('before').exists() && data.child('after').exists()) || root.child('sessions').child($code).child('games').child('beforeAfter').child('unlocked').child($uid).val() === true)) || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)"
              }
            },
            "unlocked": {
              "$uid": {
                ".write": "auth != null && ((auth.uid === $uid && !newData.exists()) || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
                ".validate": "newData.val() === true"
              }
            },
            "shown": {
              "$uid": {
                ".write": "auth != null && ((auth.uid === $uid && !newData.exists()) || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
                ".validate": "newData.val() === true"
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "photos": {
            "media": {
              "$uid": {
                ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || !data.child('photo').exists() || root.child('sessions').child($code).child('games').child('photos').child('unlocked').child($uid).val() === true)) || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)"
              }
            },
            "unlocked": {
              "$uid": {
                ".write": "auth != null && ((auth.uid === $uid && !newData.exists()) || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
                ".validate": "newData.val() === true"
              }
            },
            "shown": {
              "$uid": {
                ".write": "auth != null && ((auth.uid === $uid && !newData.exists()) || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
                ".validate": "newData.val() === true"
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "box": {
            "round": {
              ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
              "decision": {
                ".write": "auth != null && !data.exists() && root.child('sessions').child($code).child('games').child('box').child('round').child('peeker').val() !== auth.uid && (root.child('sessions').child($code).child('games').child('box').child('round').child('players').child('a').val() === auth.uid || root.child('sessions').child($code).child('games').child('box').child('round').child('players').child('b').val() === auth.uid)",
                ".validate": "newData.val() === 'swap' || newData.val() === 'keep'"
              }
            },
            "played": {
              "$uid": {
                ".write": "auth != null && ((auth.uid === $uid && !newData.exists()) || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
                ".validate": "newData.val() === true"
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "game": {
          ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
          ".validate": "newData.val() === 'beforeAfter' || newData.val() === 'photos' || newData.val() === 'box'"
        },
        "jukebox": {
          "tracks": {
            ".write": "auth != null && root.child('sessions').child($code).child('hostUid').val() === auth.uid"
          },
          "durations": {
            ".write": "auth != null && root.child('sessions').child($code).child('hostUid').val() === auth.uid"
          },
          "state": {
            ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)"
          }
        },
        "showDownload": {
          ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
          ".validate": "newData.isBoolean()"
        },
        "lightUid": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()) || (!newData.exists() && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)))",
          ".validate": "newData.isString()"
        },
        "light": {
          ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid || root.child('sessions').child($code).child('lightUid').val() === auth.uid)",
          "armed": { ".validate": "newData.isBoolean()" },
          "trigger": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "mode": { ".validate": "newData.val() === 'all' || newData.val() === 'smiles'" },
          "litAt": { ".validate": "newData.isNumber()" },
          "lit": {
            "$trigger": { ".validate": "$trigger.length <= 40 && newData.isNumber()" }
          },
          "camera": {
            "starting": { ".validate": "newData.isBoolean()" },
            "off": { ".validate": "newData.isBoolean()" },
            "people": { ".validate": "newData.isNumber()" },
            "each": {
              "$trigger": { ".validate": "$trigger.length <= 40 && newData.isNumber()" }
            },
            "error": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "moves": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || (!data.exists() && newData.child('status').val() === 'asked'))) || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
            "from": { ".validate": "newData.isString()" },
            "status": { ".validate": "newData.val() === 'asked' || newData.val() === 'allowed' || newData.val() === 'declined'" },
            "$other": { ".validate": false }
          }
        },
        "display": {
          ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "boxSecrets": {
      "$code": {
        ".read": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid || root.child('sessions').child($code).child('games').child('box').child('round').child('peeker').val() === auth.uid)",
        ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
        ".validate": "newData.child('inBox').val() === 'L' || newData.child('inBox').val() === 'R'"
      }
    }
  }
}
