                "y": { ".validate": "newData.isNumber()" },
                "w": { ".validate": "newData.isNumber()" },
                "h": { ".validate": "newData.isNumber()" },
                "read": { ".validate": "newData.isBoolean()" },
                "$other": { ".validate": false }
              }
            },
            "hue": {
              "bridge": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "lamps": {
                "$i": {
                  "id": { ".validate": "newData.isString() && newData.val().length <= 40" },
                  "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
                  "color": { ".validate": "newData.isBoolean()" },
                  "$other": { ".validate": false }
                }
              },
              "chosen": {
                "$lamp": { ".validate": "$lamp.length <= 40 && newData.isBoolean()" }
              },
              "found": {
                "$i": { ".validate": "newData.isString() && newData.val().length <= 200" }
              },
              "busy": { ".validate": "newData.isString() && newData.val().length <= 100" },
              "error": { ".validate": "newData.isString() && newData.val().length <= 300" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          },
          "ask": {
            ".validate": "newData.hasChildren(['id', 'kind'])",
            "id": { ".validate": "newData.isNumber()" },
            "kind": { ".validate": "newData.val() === 'camera' || newData.val() === 'processor' || newData.val() === 'find' || newData.val() === 'connect' || newData.val() === 'lamp' || newData.val() === 'test'" },
            "value": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "handovers": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || (!data.exists() && newData.child('status').val() === 'asked' && !root.child('pins').child($code).exists()))) || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
            "pair": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{3}$/)" },
            "from": { ".validate": "newData.isString()" },
            "status": { ".validate": "newData.val() === 'asked' || newData.val() === 'declined' || newData.val() === 'handed' || newData.val() === 'elsewhere'" },
            "$other": { ".validate": false }
          }
        },
        "moves": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || (!data.exists() && newData.child('status').val() === 'asked'))) || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
            "from": { ".validate": "newData.isString()" },
            "status": { ".validate": "newData.val() === 'asked' || newData.val() === 'allowed' || newData.val() === 'declined'" },
            "$other": { ".validate": false }
          }
        },
        "scoreboard": {
          ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
          "contestants": {
            "$id": {
              ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && !root.child('sessions').child($code).child('scoreboard').child('locked').isNumber()",
              "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
              "photo": {
                ".write": "auth != null && data.parent().child('uid').val() === auth.uid && !root.child('sessions').child($code).child('scoreboard').child('locked').isNumber()",
                ".validate": "newData.isString() && newData.val().length <= 2000"
              },
              "crop": {
                ".write": "auth != null && data.parent().child('uid').val() === auth.uid && !newData.exists() && !root.child('sessions').child($code).child('scoreboard').child('locked').isNumber()",
                ".validate": "newData.hasChildren(['x', 'y', 'w', 'h'])",
                "$k": { ".validate": "($k === 'x' || $k === 'y' || $k === 'w' || $k === 'h') && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" }
              },
              "order": { ".validate": "newData.isNumber()" },
              "uid": {
                ".write": "auth != null && data.parent().exists() && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid || !root.child('sessions').child($code).child('players').child(data.val()).exists())",
                ".validate": "newData.isString()"
              },
              "$other": { ".validate": false }
            }
          },
          "tasks": {
            "$id": {
              "order": { ".validate": "newData.isNumber()" },
              "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
              "game": { ".validate": "newData.isString()" },
              "description": { ".validate": "newData.isString() && newData.val().length <= 600" },
              "song": { ".validate": "newData.isString() && newData.val().length <= 300" },
              "transition": { ".validate": "newData.isString() && newData.val().length <= 300" },
              "transitionImage": { ".validate": "newData.isString() && newData.val().length <= 300" },
              "transitionVideo": { ".validate": "newData.isString() && newData.val().length <= 300" },
              "type": { ".validate": "newData.isString() && newData.val().length <= 30" },
              "text": { ".validate": "newData.isString() && newData.val().length <= 5000" },
              "limit": { ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 59999000" },
              "parts": {
                "$i": {
                  ".validate": "$i.matches(/^[0-9]$/)",
                  "type": { ".validate": "newData.isString() && newData.val().length <= 30" },
                  "text": { ".validate": "newData.isString() && newData.val().length <= 5000" },
                  "limit": { ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 59999000" },
                      "$other": { ".validate": false }
                }
              },
              "unit": {
                ".validate": "newData.hasChildren(['name', 'amount', 'unit', 'kind'])",
                "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
                "amount": { ".validate": "newData.isNumber() && newData.val() > 0" },
                "unit": { ".validate": "newData.val() === 'mm' || newData.val() === 'cm' || newData.val() === 'm' || newData.val() === 'in' || newData.val() === 'ft' || newData.val() === 'g' || newData.val() === 'kg' || newData.val() === 'oz' || newData.val() === 'lb' || newData.val() === 'sec' || newData.val() === 'min' || newData.val() === 'hr' || newData.val() === 'ml' || newData.val() === 'L' || newData.val() === 'tsp' || newData.val() === 'tbsp' || newData.val() === 'fl oz' || newData.val() === 'cup' || newData.val() === 'pt' || newData.val() === 'qt' || newData.val() === 'gal' || newData.val() === 'dB'" },
                "kind": { ".validate": "newData.val() === 'height' || newData.val() === 'length' || newData.val() === 'weight' || newData.val() === 'time' || newData.val() === 'volume' || newData.val() === 'loudness'" },
                "$other": { ".validate": false }
              },
              "scores": { "$cid": { ".validate": "newData.isNumber()" } },
              "scoring": { ".validate": "newData.val() === 'highest' || newData.val() === 'lowest'" },
              "results": { "$cid": { ".validate": "newData.isNumber()" } },
              "given": { "$cid": { ".validate": "newData.isNumber()" } },
              "dq": { "$cid": { ".validate": "newData.val() === true" } },
              "dqStays": { ".validate": "newData.val() === true" },
              "checkin": { ".validate": "newData.val() === true" },
              "bonus": { "$cid": { ".validate": "newData.val() === true || newData.val() === 1 || newData.val() === 2" } },
              "dqOver": { ".validate": "newData.isNumber()" },
              "overDq": { "$cid": { ".validate": "newData.val() === true" } },
              "restarts": { "$cid": { ".validate": "newData.isNumber()" } },
              "draw": { ".validate": "newData.isString() && newData.val().length <= 120" },
              "minutes": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 120" },
              "$other": { ".validate": false }
            }
          },
          "shown": { "$task": { "$cid": { ".validate": "newData.isNumber()" } } },
          "pixelate": { ".validate": "newData.val() === false" },
          "final": { ".validate": "newData.val() === true" },
          "locked": { ".validate": "newData.isNumber() || newData.val() === false" },
          "tiebreaker": {
            "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "description": { ".validate": "newData.isString() && newData.val().length <= 600" },
            "song": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "type": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "text": { ".validate": "newData.isString() && newData.val().length <= 5000" },
            "limit": { ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 59999000" },
            "parts": {
              "$i": {
                ".validate": "$i.matches(/^[0-9]$/)",
                "type": { ".validate": "newData.isString() && newData.val().length <= 30" },
                "text": { ".validate": "newData.isString() && newData.val().length <= 5000" },
                "limit": { ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 59999000" },
                "$other": { ".validate": false }
            }
            },
              "winner": { ".validate": "newData.isString() && root.child('sessions').child($code).child('scoreboard').child('contestants').child(newData.val()).exists()" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "display": {
          ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "pins": {
      "$code": {
        ".read": "auth != null && (root.child('hostTrust').child($code).child(auth.uid).val() === data.val() || (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid))",
        ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4,6}$/)"
      }
    },
    "hostTrust": {
      "$code": {
        ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 6"
        }
      }
    },
    "boxSecrets": {
      "$code": {
        ".read": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid || root.child('sessions').child($code).child('games').child('box').child('round').child('peeker').val() === auth.uid)",
        ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
        ".validate": "newData.child('inBox').val() === 'L' || newData.child('inBox').val() === 'R'"
      }
    },
    "hostLeftovers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$code": {
          "at": { ".validate": "newData.isNumber()" },
          "tasks": {
            "$i": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" }
          },
          "$other": { ".validate": false }
        }
      }
    },
    "secretTasks": {
      "$code": {
        ".read": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
        "pool": {
          ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
          "$id": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300"
          }
        },
        "assigned": {
          ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().length <= 300"
          }
        },
        "seen": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (auth.uid === $uid || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
            ".validate": "newData.val() === true"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "noisemasterSecrets": {
      "$code": {
        ".read": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
        ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
        "board": {
          "$i": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
